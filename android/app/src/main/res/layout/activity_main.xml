<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnLoadItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tải danh sách Items"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnQrScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quét QR Code"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm bạn quanh đây"
        android:layout_marginBottom="8dp" />

    <!-- Bài mẫu migrate Nexacro: docs/nexacro-migration/MIGRATION_LAB.md -->
    <Button
        android:id="@+id/btnProductSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tra cứu sản phẩm (bài mẫu Nexacro)"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnNexacroGateway"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Demo X-API → JSON"
        android:layout_marginBottom="8dp" />

    <!-- Task 17/18: docs/task-17-18-disposal/README.md -->
    <Button
        android:id="@+id/btnDisposal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phiếu hủy hàng"
        android:layout_marginBottom="8dp" />

    <!-- Cùng chức năng, viết kiểu Java thuần (thread + HttpURLConnection, View trong HashMap) -->
    <Button
        android:id="@+id/btnDisposalPlain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phiếu hủy hàng (Java thuần)"
        android:layout_marginBottom="8dp" />

    <!-- Chỉ hiện với ADMIN (MainActivity) -->
    <Button
        android:id="@+id/btnFindPda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm PDA"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textSize="15sp"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:text="Bấm nút ở trên để tải danh sách..." />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="16dp" />
</LinearLayout>
