<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnLoadItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tải danh sách Items"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnQrScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quét QR Code"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm bạn quanh đây"
        android:layout_marginBottom="8dp" />

    <!-- Chỉ hiện với ADMIN (MainActivity) -->
    <Button
        android:id="@+id/btnFindPda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm PDA"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textSize="15sp"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:text="Bấm nút ở trên để tải danh sách..." />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="16dp" />

    <!-- Lấy log trên máy ra để điều tra sự cố (LogExporter) -->
    <Button
        android:id="@+id/btnExportLog"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Xuất log"
        android:layout_marginTop="4dp" />
</LinearLayout>
