<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tìm bạn quanh đây"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvMyLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vị trí của bạn: đang lấy..."
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnRefreshNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cập nhật vị trí + Tìm bạn"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvNearbyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:textSize="15sp"
        android:text="Bấm nút để tìm..." />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại"
        android:layout_marginTop="16dp" />
</LinearLayout>
