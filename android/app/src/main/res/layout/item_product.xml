<?xml version="1.0" encoding="utf-8"?>
<!--
  1 dòng của Grid grd_list (Band body). Trên màn PDA nhỏ, thay vì 3 cột ngang,
  hiển thị dạng thẻ: tên ở trên, barcode + tồn kho ở dưới.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Cell col="1": bind:name -->
    <TextView
        android:id="@+id/txtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cell col="0": bind:barcode -->
        <TextView
            android:id="@+id/txtBarcode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" />

        <!-- Cell col="2": bind:stockQuantity, đỏ khi = 0 -->
        <TextView
            android:id="@+id/txtStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
