<?xml version="1.0" encoding="utf-8"?>
<!-- Demo gọi service Nexacro cũ (X-API) qua cổng JSON: docs/NEXACRO_XAPI_TO_JSON.md -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <Button
        android:id="@+id/btnDemoSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Tra cứu (product/search.do)" />

    <Button
        android:id="@+id/btnDemoCodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Mã chung, nhiều Dataset (code/list.do)" />

    <Button
        android:id="@+id/btnDemoSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Lưu nhập kho, có rowtype (stock/save.do)" />

    <Button
        android:id="@+id/btnDemoError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Lưu sai: ErrorCode &lt; 0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:text="Bấm 1 nút để gọi service" />
    </ScrollView>
</LinearLayout>
